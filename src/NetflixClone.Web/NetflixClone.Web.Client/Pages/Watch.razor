@page "/watch/{MovieId:int}"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@implements IAsyncDisposable
@inject CatalogApiClient Api
@inject AuthSession Session
@inject ActiveProfileState Active
@inject IJSRuntime JS
@inject WatchHistoryApiClient History
@inject ViewingSessionsApiClient Viewing
<PageTitle>Watch demo · Netflix Clone</PageTitle>
<NavigationLock OnBeforeInternalNavigation="BeforeNavigate" />
<AuthShell>
    <a class="btn btn-outline-light mb-4" href="@($"/movies/{MovieId}")">← Movie details</a>
    @if (Session.Initialized && !Session.IsAuthenticated) { <a class="btn btn-danger" href="/login">Sign in</a> }
    else if (Session.Initialized && Active.Selected is null) { <a class="btn btn-danger" href="@($"/select-profile?returnTo={Uri.EscapeDataString($"/movies/{MovieId}")}")">Choose a profile</a> }
    else if (busy) { <p role="status">Preparing your video…</p> }
    else if (error is not null)
    {
        <div class="alert alert-warning" role="alert">@error</div>
        @if (subscriptionRequired) { <NavLink class="btn btn-danger me-3" href="/subscription">View subscription plans</NavLink> }
        <button class="btn btn-outline-light" @onclick="Load">Try again</button>
    }
    else if (playback is not null)
    {
        <h1 class="h2">@playback.Title</h1>
        <p class="text-muted">Demo video · Blender sample footage, not the selected movie.</p>
        @if (viewingError is not null) { <p class="small text-warning" role="status">@viewingError</p> }
        @if (progressError is not null)
        {
            <div class="alert alert-warning" role="alert">@progressError
                <button class="btn btn-outline-dark ms-2" @onclick="Load">Reload saved progress</button>
            </div>
        }
        else if (progressReady) { <p class="small text-muted" role="status">@(progressCompleted ? "Demo completed." : "Progress saves automatically while watching and when paused.")</p> }
        <video @ref="player" class="demo-player w-100" controls playsinline preload="metadata" crossorigin="anonymous">
            Your browser does not support HTML video.
        </video>
        @if (renewing) { <p role="status">Renewing playback access…</p> }
    }
</AuthShell>
@code {
    [Parameter] public int MovieId { get; set; }
    private PlaybackReply? playback;
    private string? error, pendingUrl;
    private bool busy, renewing, disposed, subscriptionRequired;
    private long version;
    private long progressProfileVersion;
    private int progressProfileId, progressMovieId, resumeSeconds;
    private DateTime? progressStamp;
    private bool progressReady, progressCompleted;
    private string? progressError;
    private string? viewingError;
    private readonly SemaphoreSlim progressGate = new(1, 1);
    private readonly string playerId = Guid.NewGuid().ToString("N");
    private ElementReference player;
    private IJSObjectReference? module;
    private DotNetObjectReference<Watch>? self;
    private readonly CancellationTokenSource lifetime = new();
    protected override async Task OnInitializedAsync()
    {
        Active.Changed += Changed;
        await Active.InitializeAsync();
    }
    protected override Task OnParametersSetAsync() => Load();
    private void Changed() => _ = InvokeAsync(async () =>
    {
        if (disposed) return;
        // Never start playback automatically for a different profile.
        version++; pendingUrl = null; playback = null; busy = renewing = false;
        progressReady = false;
        error = "Your profile changed. Start playback again.";
        await Stop();
        StateHasChanged();
    });
    private async Task Stop()
    {
        if (module is not null)
        {
            try { await module.InvokeVoidAsync("stop", player, playerId); }
            catch (JSException) { }
        }
    }
    private async Task BeforeNavigate(Microsoft.AspNetCore.Components.Routing.LocationChangingContext context)
    {
        if (module is null || disposed) return;
        try
        {
            if (progressReady) await module.InvokeVoidAsync("flush", playerId);
            await module.InvokeVoidAsync("closeViewing", playerId);
        }
        catch (JSException) { }
    }
    private async Task Load()
    {
        // Close the previous session before invalidating callbacks for a reload/new movie.
        await Stop();
        var request = ++version;
        busy = true; renewing = false; error = null; playback = null; pendingUrl = null;
        subscriptionRequired = false;
        progressReady = false; progressError = null; resumeSeconds = 0; progressStamp = null; progressCompleted = false;
        viewingError = null;
        await Active.InitializeAsync();
        if (disposed || request != version) return;
        if (!Session.IsAuthenticated || Active.Selected is null) { busy = false; return; }
        progressProfileVersion = Active.Version;
        progressProfileId = Active.Selected.ProfileId;
        progressMovieId = MovieId;
        var saved = await History.GetAsync(progressProfileId, progressMovieId, lifetime.Token);
        if (disposed || request != version || progressProfileVersion != Active.Version) return;
        if (saved.Success)
        {
            progressReady = true; progressStamp = saved.Value!.UpdatedAtUtc;
            progressCompleted = saved.Value.IsCompleted;
            resumeSeconds = saved.Value.IsCompleted ? 0 : saved.Value.PositionSeconds;
        }
        else progressError = saved.Error; // Never overwrite unknown progress after a failed GET.
        await Issue(request, Active.Version, Active.Selected.ProfileId);
    }
    private async Task Issue(long request, long profileVersion, int profileId)
    {
        var result = await Api.PlaybackAsync(profileId, MovieId, lifetime.Token);
        if (disposed || request != version || profileVersion != Active.Version) return;
        busy = renewing = false;
        if (!result.Success || result.Value is not { } value || value.MovieId != MovieId ||
            !value.IsDemo || value.ContentType != "video/mp4" ||
            value.ExpiresAtUtc <= DateTime.UtcNow || Api.PlaybackUrl(value.VideoUrl, MovieId) is not { } url)
        {
            playback = null; pendingUrl = null;
            error = result.Error ?? "Could not prepare protected playback.";
            subscriptionRequired = result.Status == 403 && result.Code != "Profiles.UnlockRequired";
            await Stop();
            return;
        }
        playback = value; pendingUrl = url;
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (disposed || pendingUrl is null || playback is null) return;
        var request = version; var url = pendingUrl; var expires = playback.ExpiresAtUtc;
        pendingUrl = null;
        try
        {
            module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/demo-player.js");
            if (disposed || request != version) return;
            self ??= DotNetObjectReference.Create(this);
            await module.InvokeVoidAsync("setSource", player, url, expires, self, request, playerId, resumeSeconds);
        }
        catch (JSException)
        {
            if (!disposed && request == version)
            {
                error = "Could not initialize the video player."; playback = null;
                await Stop(); StateHasChanged();
            }
        }
    }
    [JSInvokable]
    public async Task ReportProgress(long expectedVersion, int position, int duration, bool ended)
    {
        if (disposed || !progressReady || expectedVersion != version) return;
        try { await progressGate.WaitAsync(lifetime.Token); }
        catch (OperationCanceledException) { return; }
        try
        {
            if (disposed || !progressReady || expectedVersion != version || progressProfileVersion != Active.Version ||
                !Session.IsAuthenticated || Active.Selected?.ProfileId != progressProfileId) return;
            var result = await History.SaveAsync(progressProfileId, progressMovieId, position, duration, ended, progressStamp, lifetime.Token);
            if (disposed || expectedVersion != version || progressProfileVersion != Active.Version) return;
            if (result.Success)
            {
                progressStamp = result.Value!.UpdatedAtUtc;
                progressCompleted = result.Value.IsCompleted;
            }
            else { progressReady = false; progressError = result.Error; }
            StateHasChanged();
        }
        finally { progressGate.Release(); }
    }
    [JSInvokable]
    public async Task<ViewingSessionReply?> StartViewingSession(long expectedVersion, string clientId)
    {
        if (!CanRecordViewing(expectedVersion) || !Guid.TryParse(clientId, out var key)) return null;
        var reply = await Viewing.StartAsync(progressProfileId, progressMovieId, key, lifetime.Token);
        if (!CanRecordViewing(expectedVersion)) return null;
        viewingError = reply is null ? "Viewing activity could not be saved. Playback will continue; recording will retry." : null;
        StateHasChanged();
        return reply;
    }
    [JSInvokable]
    public async Task<ViewingSessionReply?> SaveViewingCheckpoint(long expectedVersion, int sessionId, long sequence, long milliseconds, string? endReason)
    {
        if (!CanRecordViewing(expectedVersion)) return null;
        var reply = await Viewing.CheckpointAsync(progressProfileId, progressMovieId, sessionId, sequence, milliseconds, endReason, lifetime.Token);
        if (!CanRecordViewing(expectedVersion)) return null;
        viewingError = reply is null ? "Viewing activity could not be saved. Recording will retry." : null;
        StateHasChanged();
        return reply;
    }
    private bool CanRecordViewing(long expectedVersion) => !disposed && expectedVersion == version &&
        progressProfileVersion == Active.Version && Session.IsAuthenticated && Active.Selected?.ProfileId == progressProfileId;
    [JSInvokable]
    public async Task RenewPlayback(long expectedVersion)
    {
        if (disposed || renewing || expectedVersion != version || playback is null ||
            !Session.IsAuthenticated || Active.Selected is not { } profile) return;
        renewing = true;
        await Issue(version, Active.Version, profile.ProfileId);
        if (!disposed) StateHasChanged();
    }
    [JSInvokable]
    public async Task PlaybackFailed(long expectedVersion)
    {
        if (disposed || expectedVersion != version) return;
        version++; error = "The video could not be played. Check your connection and try again.";
        playback = null; pendingUrl = null; renewing = busy = false;
        await Stop(); StateHasChanged();
    }
    public async ValueTask DisposeAsync()
    {
        await Stop();
        disposed = true; version++; Active.Changed -= Changed; lifetime.Cancel();
        if (module is not null) await module.DisposeAsync();
        self?.Dispose(); lifetime.Dispose();
    }
}
