@page "/select-profile"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@implements IDisposable
@inject AuthSession Session
@inject ActiveProfileState Active
@inject ProfilesApiClient Api
@inject NavigationManager Navigation
<PageTitle>Choose a profile · Netflix Clone</PageTitle>
<AuthShell>
    <div class="profiles-content mx-auto">
        <p class="eyebrow">YOUR OWN SPACE</p>
        <h1 class="display-5 fw-bold">Who's watching?</h1>
        <p class="text-muted">Choose whose My List to use. You can switch profiles at any time.</p>
        @if (!Session.IsAuthenticated && Session.Initialized) { <a class="btn btn-danger" href="/login">Sign in</a> }
        else if (loading) { <p role="status">Loading profiles…</p> }
        else
        {
            @if (error is not null) { <div class="alert alert-warning" role="alert">@error</div> }
            <div class="d-flex gap-3 my-4"><button class="btn btn-outline-light" disabled="@busy" @onclick="Load">Reload</button><a class="btn btn-outline-light" href="/profiles">Manage profiles</a></div>
            @if (profiles.Count == 0 && error is null) { <p>Create your first profile to start saving movies.</p><a class="btn btn-danger" href="/profiles">Create a profile</a> }
            <div class="row g-3">
                @foreach (var profile in profiles)
                {
                    <div class="col-12 col-sm-6 col-lg-4" @key="profile.ProfileId">
                        <button class="profile-choice auth-panel p-4 w-100 h-100 text-start" disabled="@busy" @onclick="() => Choose(profile.ProfileId)">
                            <span class="profile-avatar mb-3" aria-hidden="true">@(profile.IsKids ? "☺" : "●")</span>
                            <span class="h4 d-block text-break">@profile.Name</span>
                            <span class="text-muted d-block">@(profile.IsKids ? "Kids profile" : "Standard profile")</span>
                            @if (Active.Selected?.ProfileId == profile.ProfileId) { <span class="badge text-bg-secondary mt-2">Selected</span> }
                        </button>
                    </div>
                }
            </div>
            @if (busy) { <p class="mt-3" role="status">Selecting profile…</p> }
        }
    </div>
</AuthShell>
@code {
    [SupplyParameterFromQuery(Name = "returnTo")] public string? ReturnTo { get; set; }
    private List<ProfileReply> profiles = [];
    private string? error;
    private bool loading, busy, disposed;
    private int requestVersion;
    private long lastVersion = -1;
    private readonly CancellationTokenSource lifetime = new();
    protected override async Task OnInitializedAsync()
    {
        Active.Changed += Changed;
        await Active.InitializeAsync();
        await Load();
    }
    private void Changed() => _ = InvokeAsync(async () =>
    {
        if (!disposed && lastVersion != Active.Version) { await Load(); StateHasChanged(); }
    });
    private async Task Load()
    {
        if (disposed) return;
        var request = ++requestVersion; var version = Active.Version;
        lastVersion = version; profiles = []; error = null; loading = true;
        if (!Session.IsAuthenticated) { loading = false; return; }
        var result = await Api.ListAsync(lifetime.Token);
        if (disposed || request != requestVersion || version != Active.Version) return;
        loading = false;
        if (!result.Success) { error = result.Error; return; }
        profiles = result.Value!.Profiles; Active.Reconcile(profiles);
    }
    private async Task Choose(int id)
    {
        if (busy) return;
        busy = true;
        try
        {
            error = await Active.SelectAsync(id);
            if (disposed || error is not null) return;
            // Only these local destinations are accepted; never navigate to arbitrary input.
            var destination = ReturnTo == "/my-list" || System.Text.RegularExpressions.Regex.IsMatch(ReturnTo ?? "", @"\A/movies/[1-9][0-9]*\z")
                ? ReturnTo! : "/browse";
            Navigation.NavigateTo(destination);
        }
        finally { if (!disposed) busy = false; }
    }
    public void Dispose() { disposed = true; Active.Changed -= Changed; lifetime.Cancel(); lifetime.Dispose(); }
}
