@page "/watch-history"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@implements IDisposable
@inject AuthSession Session
@inject ActiveProfileState Active
@inject WatchHistoryApiClient Api
<PageTitle>Watch history · Netflix Clone</PageTitle>
<AuthShell>
    <p class="eyebrow">YOUR VIEWING ACTIVITY</p>
    <h1 class="display-5 fw-bold">Watch history</h1>
    @if (initializing) { <p role="status">Loading your profile…</p> }
    else if (!Session.IsAuthenticated)
    {
        <p>Sign in to see your watch history.</p><a class="btn btn-danger" href="/login">Sign in</a>
    }
    else if (Active.Selected is null)
    {
        <p>Choose a profile to see its watch history.</p>
        <a class="btn btn-danger" href="/select-profile?returnTo=/watch-history">Choose profile</a>
    }
    else
    {
        <div class="d-flex flex-wrap align-items-center gap-3 mb-4">
            <p class="text-muted mb-0">Recently watched by <strong>@Active.Selected.Name</strong></p>
            <a class="btn btn-outline-light" href="/select-profile?returnTo=/watch-history">Switch profile</a>
            <button class="btn btn-outline-light" disabled="@loading" @onclick="Load">Reload history</button>
        </div>
        @if (error is not null) { <div class="alert alert-warning" role="alert">@error</div> }
        @if (loading) { <p role="status">Loading your history…</p> }
        else if (history is not null)
        {
            @if (history.TotalCount == 0)
            {
                <div class="auth-panel p-4"><h2 class="h4">No watch history is visible for this profile.</h2>
                    <p>Movies you start appear here, including completed movies. This profile's age setting applies.</p>
                    <a class="btn btn-danger" href="/browse">Explore movies</a></div>
            }
            @foreach (var item in history.Items)
            {
                <article class="auth-panel p-3 mb-3" @key="item.Movie.MovieId">
                    <div class="row align-items-center g-3">
                        <div class="col-3 col-md-1">
                            <CatalogImage Src="@item.Movie.ThumbnailUrl" Alt="@($"{item.Movie.Title} poster")" CssClass="img-fluid rounded" />
                        </div>
                        <div class="col-9 col-md-7">
                            <h2 class="h5">@item.Movie.Title</h2>
                            <p class="mb-1">@(item.IsCompleted ? "Completed" : $"In progress · {Position(item.PositionSeconds)}")</p>
                            <p class="small text-muted mb-0">Last watched: @item.LastWatchedAtUtc.ToLocalTime().ToString("g")</p>
                        </div>
                        <div class="col-12 col-md-4 text-md-end">
                            @if (item.Movie.IsAvailable)
                            {
                                <a class="btn btn-danger" href="@($"/watch/{item.Movie.MovieId}")" aria-label="@($"{(item.IsCompleted ? "Watch again" : "Continue watching")} {item.Movie.Title}")">
                                    @(item.IsCompleted ? "Watch again" : "Continue watching")
                                </a>
                            }
                            else { <span class="text-muted">Currently unavailable</span> }
                        </div>
                    </div>
                </article>
            }
            @if (history.TotalCount > 0)
            {
                <nav class="d-flex justify-content-center align-items-center gap-3 mt-4" aria-label="Watch history pages">
                    <button class="btn btn-outline-light" disabled="@(page <= 1)" @onclick="Previous">Previous</button>
                    <span>Page @(page) of @Math.Max(1, (int)Math.Ceiling(history.TotalCount / 20d))</span>
                    <button class="btn btn-outline-light" disabled="@((long)page * 20 >= history.TotalCount)" @onclick="Next">Next</button>
                </nav>
            }
        }
    }
</AuthShell>
@code {
    private WatchHistoryReply? history;
    private string? error;
    private int page = 1;
    private long generation;
    private bool initializing = true, loading, disposed;
    private readonly CancellationTokenSource lifetime = new();
    private static string Position(int seconds) => TimeSpan.FromSeconds(seconds).ToString(seconds >= 3600 ? @"h\:mm\:ss" : @"m\:ss");
    protected override async Task OnInitializedAsync()
    {
        Active.Changed += Changed;
        await Active.InitializeAsync();
        initializing = false;
        if (!disposed) await Load();
    }
    private void Changed() => _ = InvokeAsync(async () => {
        if (!disposed) { page = 1; await Load(); StateHasChanged(); }
    });
    private async Task Load()
    {
        var request = ++generation; var version = Active.Version; var profile = Active.Selected;
        history = null; error = null; loading = false;
        if (disposed || profile is null || !Session.IsAuthenticated) return;
        loading = true;
        var result = await Api.ListAsync(profile.ProfileId, page, lifetime.Token);
        if (disposed || request != generation || version != Active.Version) return;
        loading = false;
        if (!result.Success)
        {
            error = result.Status == 401 ? "Please sign in again." : "Could not load watch history. Please try reloading.";
            if (result.Status == 404) Active.InvalidateIfCurrent(profile.ProfileId, version);
            return;
        }
        history = result.Value!;
        if (page > 1 && history.Items.Length == 0)
        {
            page = Math.Max(1, (int)Math.Ceiling(history.TotalCount / 20d));
            await Load();
        }
    }
    private async Task Previous() { if (!loading && page > 1) { page--; await Load(); } }
    private async Task Next() { if (!loading) { page++; await Load(); } }
    public void Dispose() { disposed = true; generation++; Active.Changed -= Changed; lifetime.Cancel(); lifetime.Dispose(); }
}
