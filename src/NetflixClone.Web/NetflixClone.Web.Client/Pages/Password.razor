@page "/forgot-password"
@page "/reset-password"
@page "/change-password"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@implements IDisposable
@using System.ComponentModel.DataAnnotations
@inject AuthApiClient Api
@inject AuthSession Session
@inject NavigationManager Navigation
@inject IJSRuntime JS
<PageTitle>@Title · Netflix Clone</PageTitle>
<AuthShell>
    <section class="auth-panel p-4 p-md-5 form-panel mx-auto">
        <h1 class="h2">@Title</h1>
        @if (!ready) { <p role="status">Preparing…</p> }
        else if (change && notice is null && !Session.IsAuthenticated) { <p>@error</p><NavLink href="/login">Sign in to change your password</NavLink> }
        else if (reset && notice is null && (link.AccountId <= 0 || link.Token.Length != 64)) { <p>This reset link is missing or invalid.</p><NavLink href="/forgot-password">Request a new link</NavLink> }
        else
        {
            @if (error is not null) { <div class="alert alert-danger" role="alert">@error</div> }
            @if (notice is not null) { <div class="alert alert-success" role="status">@notice</div><NavLink href="/login">Back to sign in</NavLink> }
            else if (forgot)
            {
                <p class="text-muted">Enter your account email. We'll send a link to choose a new password.</p>
                <EditForm Model="email" OnValidSubmit="Forgot" FormName="forgot-password"><DataAnnotationsValidator />
                    <fieldset disabled="@busy"><label for="forgot-email" class="form-label">Email address</label><InputText id="forgot-email" type="email" autocomplete="email" class="form-control mb-2" @bind-Value="email.Email" /><ValidationMessage For="() => email.Email" />
                    <button class="btn btn-danger w-100 mt-3" type="submit">@(busy ? "Sending…" : "Send reset link")</button></fieldset>
                </EditForm>
            }
            else
            {
                <p class="text-muted">Use 8–64 characters. Your password is never saved in browser storage.</p>
                <p class="small text-muted">Updating your password signs out all devices, including this browser. Existing access may continue briefly until its token expires.</p>
                <EditForm Model="password" OnValidSubmit="Save" FormName="new-password"><DataAnnotationsValidator />
                    <fieldset disabled="@busy">
                    @if (change) { <label for="old-password" class="form-label">Current password</label><InputText id="old-password" type="password" autocomplete="current-password" class="form-control mb-3" @bind-Value="oldPassword" /> }
                    <label for="new-password" class="form-label">New password</label><InputText id="new-password" type="password" autocomplete="new-password" class="form-control mb-2" @bind-Value="password.NewPassword" /><ValidationMessage For="() => password.NewPassword" />
                    <label for="confirm-password" class="form-label mt-3">Confirm new password</label><InputText id="confirm-password" type="password" autocomplete="new-password" class="form-control mb-2" @bind-Value="password.ConfirmPassword" /><ValidationMessage For="() => password.ConfirmPassword" />
                    <button class="btn btn-danger w-100 mt-3" type="submit">@(busy ? "Saving…" : "Save password")</button></fieldset>
                </EditForm>
            }
        }
    </section>
</AuthShell>
@code {
    private sealed class EmailForm { [Required, EmailAddress, MaxLength(255)] public string Email { get; set; } = ""; }
    private sealed class PasswordForm { [Required, MinLength(8), MaxLength(64)] public string NewPassword { get; set; } = ""; [Required, Compare(nameof(NewPassword))] public string ConfirmPassword { get; set; } = ""; }
    public sealed class ResetLink { public int AccountId { get; set; } public string Token { get; set; } = ""; }
    private EmailForm email = new(); private PasswordForm password = new(); private ResetLink link = new();
    private string oldPassword = ""; private string? error, notice;
    private bool forgot, reset, change, ready, busy, disposed;
    private int generation;
    private string Title => forgot ? "Forgot password" : reset ? "Reset password" : "Change password";
    protected override async Task OnParametersSetAsync()
    {
        generation++; busy = false;
        var path = new Uri(Navigation.Uri).AbsolutePath;
        forgot = path == "/forgot-password"; reset = path == "/reset-password"; change = path == "/change-password";
        ready = false; error = notice = null; password = new(); oldPassword = "";
        await Session.InitializeAsync();
        if (reset)
        {
            try { var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/password-reset.js"); try { link = await module.InvokeAsync<ResetLink>("consumeLink"); } finally { await module.DisposeAsync(); } }
            catch (JSException) { error = "Could not read the reset link. Reopen the email link."; }
        }
        if (!disposed) ready = true;
    }
    private async Task Forgot()
    {
        if (busy) return; busy = true; var version = generation;
        try { var result = await Api.ForgotPasswordAsync(email.Email); if (disposed || version != generation) return; error = result.Error; if (result.Success) notice = "If an eligible account exists, a reset email has been sent. Please wait at least one minute before requesting another link."; }
        finally { if (version == generation) busy = false; }
    }
    private async Task Save()
    {
        if (busy) return;
        if (change && string.IsNullOrEmpty(oldPassword)) { error = "Enter your current password."; return; }
        busy = true; error = null; var version = generation;
        try
        {
            var resetMode = reset; var id = link.AccountId; var raw = link.Token;
            var old = oldPassword; var next = password.NewPassword; var confirm = password.ConfirmPassword;
            var result = await Session.RevokeSessionsAsync(token => resetMode
                ? Api.ResetPasswordAsync(id, raw, next, confirm)
                : Api.ChangePasswordAsync(token!, old, next, confirm), requireAuthentication: !resetMode);
            if (disposed || version != generation) return;
            error = result.Error;
            if (result.Success) { notice = "Your password has been updated and all device sessions have been revoked. Sign in again with your new password."; link.Token = ""; }
        }
        finally { if (version == generation) { oldPassword = ""; password = new(); busy = false; } }
    }
    public void Dispose() { disposed = true; generation++; oldPassword = ""; password = new(); link.Token = ""; }
}
