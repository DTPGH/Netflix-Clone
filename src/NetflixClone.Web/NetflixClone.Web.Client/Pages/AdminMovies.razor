@page "/admin/movies"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@implements IDisposable
@inject AuthSession Session
@inject AdminMoviesApiClient Api
@inject CatalogApiClient Catalog

<PageTitle>Admin movies · Netflix Clone</PageTitle>
<AuthShell>
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div><p class="eyebrow">CONTENT ADMINISTRATION</p><h1 class="display-5 fw-bold mb-2">Movies</h1>
            <p class="text-muted mb-0">Manage catalog metadata, playback availability and soft-deleted movies.</p></div>
        @if (isAdmin)
        {
            <div class="d-flex flex-wrap gap-3">
                <a class="btn btn-outline-light" href="/admin/genres">Add / manage genres</a>
                <a class="btn btn-danger" href="/admin/movies/new">Add movie</a>
            </div>
        }
    </div>
    @if (!ready) { <p role="status">Checking administrator access…</p> }
    else if (!isAdmin)
    {
        <section class="auth-panel p-4"><h2 class="h4">Administrator access required</h2>
            <p class="text-muted mb-0">Sign in with an account that currently has the Admin role.</p></section>
    }
    else
    {
        <section class="auth-panel p-3 p-md-4 mb-4" aria-label="Movie filters">
            <div class="row g-3 align-items-end">
                <div class="col-12 col-lg-4"><label class="form-label" for="admin-search">Search title</label>
                    <input id="admin-search" class="form-control" @bind="search" @bind:event="oninput" /></div>
                <div class="col-12 col-sm-6 col-lg-3"><label class="form-label" for="admin-genre-filter">Genre</label>
                    <select id="admin-genre-filter" class="form-select" @bind="genreValue"><option value="">All genres</option>
                        @foreach (var genre in genres) { <option value="@genre.GenreId">@genre.Name</option> }</select></div>
                <div class="col-12 col-sm-6 col-lg-2"><label class="form-label" for="admin-availability">Playback</label>
                    <select id="admin-availability" class="form-select" @bind="availability">
                        <option value="all">All</option><option value="available">Available</option><option value="unavailable">Unavailable</option>
                    </select></div>
                <div class="col-12 col-sm-6 col-lg-2"><label class="form-label" for="admin-deletion">Status</label>
                    <select id="admin-deletion" class="form-select" @bind="deletion">
                        <option value="active">Active</option><option value="deleted">Deleted</option><option value="all">All</option>
                    </select></div>
                <div class="col-12 col-sm-6 col-lg-1"><button class="btn btn-outline-light w-100" disabled="@(loading || busy)" @onclick="Apply">Apply</button></div>
            </div>
        </section>
        @if (error is not null) { <div class="alert alert-danger" role="alert">@error</div> }
        @if (notice is not null) { <div class="alert alert-success" role="status">@notice</div> }
        @if (loading) { <p role="status"><span class="spinner-border spinner-border-sm me-2"></span>Loading movies…</p> }
        else if (movies is not null && movies.Items.Length == 0)
        {
            <section class="auth-panel p-4 text-center"><h2 class="h4">No movies match these filters</h2>
                <p class="text-muted mb-0">Try another status, genre or title.</p></section>
        }
        else if (movies is not null)
        {
            <div class="d-grid gap-3">
                @foreach (var movie in movies.Items)
                {
                    <article class="auth-panel p-3" @key="movie.MovieId">
                        <div class="row align-items-center g-3">
                            <div class="col-3 col-sm-2 col-lg-1"><CatalogImage Src="@movie.ThumbnailUrl" Alt="@($"{movie.Title} poster")" CssClass="admin-movie-thumbnail" /></div>
                            <div class="col-9 col-sm-5 col-lg-5 min-width-0"><h2 class="h5 text-break mb-1">@movie.Title</h2>
                                <div class="d-flex flex-wrap gap-2"><span class="badge text-bg-secondary">@movie.MaturityRating</span>
                                    @if (movie.IsDeleted) { <span class="badge text-bg-danger">Deleted</span> }
                                    else { <span class="badge @(movie.IsAvailable ? "text-bg-success" : "text-bg-warning")">@(movie.IsAvailable ? "Playable" : "Playback unavailable")</span> }
                                    @if (movie.IsFeatured) { <span class="badge text-bg-info">Featured</span> }
                                </div>
                                <p class="small text-muted mb-0 mt-2">Updated @movie.UpdatedAtUtc.ToLocalTime().ToString("g")</p></div>
                            <div class="col-12 col-sm-5 col-lg-6 d-flex flex-wrap justify-content-sm-end gap-2">
                                <a class="btn btn-outline-light" href="@($"/admin/movies/{movie.MovieId}/edit")">Review</a>
                                @if (movie.IsDeleted)
                                {
                                    <button class="btn btn-danger" disabled="@busy" @onclick="() => Restore(movie)">Restore</button>
                                }
                                else if (confirmDeleteId == movie.MovieId)
                                {
                                    <button class="btn btn-danger" disabled="@busy" @onclick="() => Delete(movie)">Confirm delete</button>
                                    <button class="btn btn-outline-light" disabled="@busy" @onclick="() => confirmDeleteId = null">Cancel</button>
                                }
                                else { <button class="btn btn-outline-danger" disabled="@busy" @onclick="() => ConfirmDelete(movie.MovieId)">Soft-delete</button> }
                            </div>
                        </div>
                    </article>
                }
            </div>
            <nav class="d-flex justify-content-center align-items-center gap-3 mt-4" aria-label="Admin movie pages">
                <button class="btn btn-outline-light" disabled="@(page <= 1 || loading || busy)" @onclick="Previous">Previous</button>
                <span>Page @(page) of @Math.Max(1, (int)Math.Ceiling(movies.TotalCount / 20d))</span>
                <button class="btn btn-outline-light" disabled="@((long)page * 20 >= movies.TotalCount || loading || busy)" @onclick="Next">Next</button>
            </nav>
        }
    }
</AuthShell>

@code {
    private AdminMoviesReply? movies;
    private CatalogGenre[] genres = [];
    private string search = "", genreValue = "", availability = "all", deletion = "active";
    private string? error, notice;
    private int page = 1;
    private int? confirmDeleteId;
    private bool ready, isAdmin, loading, busy, disposed;
    private long generation;
    private readonly CancellationTokenSource lifetime = new();
    protected override async Task OnInitializedAsync()
    {
        Session.Changed += SessionChanged;
        await Session.InitializeAsync();
        await SynchronizeAccess();
    }
    private void SessionChanged() => _ = InvokeAsync(async () => { await SynchronizeAccess(); if (!disposed) StateHasChanged(); });
    private async Task SynchronizeAccess()
    {
        var state = await Session.GetAuthenticationStateAsync();
        var allowed = state.User.Identity?.IsAuthenticated == true && state.User.IsInRole("Admin");
        ready = true;
        if (allowed == isAdmin && (movies is not null || !allowed)) return;
        isAdmin = allowed; movies = null; error = notice = null; confirmDeleteId = null; generation++;
        if (!allowed) return;
        var genreReply = await Catalog.GenresAsync(lifetime.Token);
        if (disposed || !isAdmin) return;
        if (genreReply.Success) genres = genreReply.Value!.Genres;
        else error = genreReply.Error;
        await Load();
    }
    private int? GenreId => int.TryParse(genreValue, out var id) ? id : null;
    private bool? Availability => availability == "available" ? true : availability == "unavailable" ? false : null;
    private async Task Apply() { page = 1; await Load(); }
    private async Task Load()
    {
        if (!isAdmin || loading) return;
        var request = ++generation; loading = true; error = notice = null; confirmDeleteId = null;
        var result = await Api.ListAsync(page, search, GenreId, Availability, deletion, lifetime.Token);
        if (disposed || request != generation) return;
        loading = false;
        if (!result.Success) { error = result.Error; return; }
        movies = result.Value!;
        if (page > 1 && movies.Items.Length == 0) { page = Math.Max(1, (int)Math.Ceiling(movies.TotalCount / 20d)); await Load(); }
    }
    private void ConfirmDelete(int id) { confirmDeleteId = id; error = notice = null; }
    private async Task Delete(AdminMovieCard movie)
    {
        if (busy || movie.IsDeleted || confirmDeleteId != movie.MovieId) return;
        busy = true; error = notice = null;
        var result = await Api.DeleteAsync(movie.MovieId, movie.UpdatedAtUtc, lifetime.Token);
        if (!disposed)
        {
            busy = false; confirmDeleteId = null;
            if (!result.Success) error = result.Error;
            else { notice = $"{movie.Title} was soft-deleted."; await ReloadPreservingNotice(); }
        }
    }
    private async Task Restore(AdminMovieCard movie)
    {
        if (busy || !movie.IsDeleted) return;
        busy = true; error = notice = null;
        var result = await Api.RestoreAsync(movie.MovieId, movie.UpdatedAtUtc, lifetime.Token);
        if (!disposed)
        {
            busy = false;
            if (!result.Success) error = result.Error;
            else { notice = $"{movie.Title} was restored."; await ReloadPreservingNotice(); }
        }
    }
    private async Task ReloadPreservingNotice()
    {
        var saved = notice; await Load(); if (error is null) notice = saved;
    }
    private async Task Previous() { page--; await Load(); }
    private async Task Next() { page++; await Load(); }
    public void Dispose() { disposed = true; generation++; Session.Changed -= SessionChanged; lifetime.Cancel(); lifetime.Dispose(); }
}
