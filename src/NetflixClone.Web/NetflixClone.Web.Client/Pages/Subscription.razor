@page "/subscription"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@implements IDisposable
@inject AuthSession Session
@inject SubscriptionsApiClient Api
@inject SubscriptionPurchaseDraftStore Drafts
<PageTitle>Subscription · Netflix Clone</PageTitle>
<AuthShell>
    <div class="mb-4"><p class="eyebrow">YOUR SUBSCRIPTION</p><h1 class="display-5 fw-bold">Choose your next 30 days.</h1>
        <p class="lead text-muted">Simulated payment only. No money is charged and no card details are collected.</p></div>
    @if (!ready) { <p role="status">Checking your session…</p> }
    else if (account is null) { <NavLink class="btn btn-danger" href="/login">Sign in to view plans</NavLink> }
    else
    {
        @if (error is not null) { <div class="alert alert-warning" role="alert">@error</div> }
        @if (notice is not null) { <div class="alert alert-success" role="status">@notice</div> }
        <button class="btn btn-outline-light mb-4" disabled="@(busy || loading)" @onclick="Load">Refresh subscription</button>
        @if (loading) { <p role="status">Loading your subscription…</p> }
        @if (overview is not null)
        {
            <section class="auth-panel p-4 mb-4" aria-labelledby="current-plan-title">
                <h2 id="current-plan-title" class="h4">Current plan</h2>
                @if (overview.Current is { } current)
                {
                    <p class="h5">@current.PlanName <span class="badge text-bg-success">Active</span></p>
                    <p class="mb-1">Valid until @Date(current.EndDateUtc). No automatic renewal.</p>
                    <p class="text-muted mb-0">You can purchase another plan after this one expires.</p>
                    @if (current.IsEffective && current.EndDateUtc > DateTime.UtcNow)
                    {
                        <NavLink class="btn btn-danger mt-3" href="/select-profile">Choose a profile</NavLink>
                    }
                }
                else
                {
                    <p>No active subscription.</p>
                    @if (overview.Latest is { } last) { <p class="small text-muted mb-0">Last plan: @last.PlanName · @last.Status · ended @Date(last.EndDateUtc)</p> }
                }
            </section>
        }
        @if (draft is not null)
        {
            <section class="auth-panel border-warning p-4 mb-4" aria-labelledby="purchase-confirm-title">
                <h2 id="purchase-confirm-title" class="h4">@(draft.Submitted ? "Check your pending purchase" : "Confirm simulated payment")</h2>
                <p class="h5">@draft.PlanName · @Money(draft.DisplayPrice) VND / 30 days</p>
                <p>@(draft.Submitted ? "The previous result may not have reached this browser. Retry checks the same purchase; it will not create a second subscription." : "Your plan starts immediately after the simulated payment succeeds. This is a demo, not a real charge.")</p>
                <div class="d-flex flex-wrap gap-3">
                    <button class="btn btn-danger" disabled="@(busy || loading)" @onclick="Purchase">@(busy ? "Checking payment…" : draft.Submitted ? "Retry / check same purchase" : "Confirm simulated payment")</button>
                    @if (!draft.Submitted) { <button class="btn btn-outline-light" disabled="@(busy || loading)" @onclick="Cancel">Cancel</button> }
                </div>
            </section>
        }
        @if (plans is not null && overview is not null && draft is null && overview.Current is null)
        {
            <h2 class="h3 mb-3">Available plans</h2>
            @if (plans.Length == 0) { <p>No plans are currently offered. Please check again later.</p> }
            <div class="row g-3 mb-4">@foreach (var plan in plans)
            {
                <div class="col-12 col-md-6 col-lg-4" @key="plan.PlanId"><section class="auth-panel p-4 h-100">
                    <h3 class="h4">@plan.Name</h3><p class="h3 my-3">@Money(plan.Price) <span class="small text-muted">VND</span></p>
                    <p>@plan.DurationDays days · no automatic renewal</p>
                    <p class="small text-muted">Configured quality: @plan.MaxQuality · @plan.MaxConcurrentStreams concurrent streams. Playback limits are not enforced in this demo.</p>
                    <button class="btn btn-danger w-100" disabled="@(busy || loading)" @onclick="() => Select(plan)">Choose plan</button>
                </section></div>
            }</div>
        }
        <h2 class="h3 mt-4">Payment history</h2>
        @if (history is not null)
        {
            @if (history.TotalCount == 0) { <p class="text-muted">No payments yet.</p> }
            @foreach (var payment in history.Items)
            {
                <section class="auth-panel p-3 mb-3 d-flex flex-wrap justify-content-between gap-3" @key="payment.PaymentId">
                    <div><h3 class="h5">@payment.PlanName</h3><p class="mb-1">@Money(payment.Amount) @payment.Currency · @payment.Status · @payment.Method</p>
                        <p class="small text-muted mb-0">@Date(payment.PaidAtUtc ?? payment.CreatedAtUtc) · <span class="text-break">@payment.TransactionCode</span></p></div>
                </section>
            }
            @if (history.TotalCount > history.PageSize)
            {
                <div class="d-flex flex-wrap gap-3 align-items-center"><button class="btn btn-outline-light" disabled="@(busy || loading || history.Page == 1)" @onclick="() => HistoryPage(history.Page - 1)">Previous</button>
                    <span>Page @history.Page of @((history.TotalCount + history.PageSize - 1) / history.PageSize)</span>
                    <button class="btn btn-outline-light" disabled="@(busy || loading || history.Page * history.PageSize >= history.TotalCount)" @onclick="() => HistoryPage(history.Page + 1)">Next</button></div>
            }
        }
    }
</AuthShell>
@code {
    private string? account, error, notice;
    private bool ready, loading, busy, disposed;
    private int generation;
    private SubscriptionPlan[]? plans;
    private SubscriptionOverview? overview;
    private SubscriptionPaymentPage? history;
    private SubscriptionPurchaseDraft? draft;
    private readonly CancellationTokenSource lifetime = new();
    private static string Money(decimal value) => value.ToString("N2", System.Globalization.CultureInfo.GetCultureInfo("vi-VN"));
    private static string Date(DateTime? value) => value?.ToLocalTime().ToString("dd MMM yyyy HH:mm") ?? "—";
    protected override async Task OnInitializedAsync() { Session.Changed += Changed; await Session.InitializeAsync(); await Access(); }
    private void Changed() => _ = InvokeAsync(async () => { if (!disposed) { await Access(); StateHasChanged(); } });
    private async Task Access()
    {
        var next = Session.IsAuthenticated ? (await Session.GetAuthenticationStateAsync()).User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value : null;
        ready = true;
        if (next == account) return;
        account = next; generation++; plans = null; overview = null; history = null; draft = null; error = notice = null; busy = loading = false;
        if (account is not null)
        {
            var version = generation; var owner = account;
            try { var saved = await Drafts.ReadAsync(owner); if (!disposed && version == generation) draft = saved; }
            catch (JSException) { error = "Purchase recovery storage is unavailable. Enable browser storage before purchasing."; }
            if (!disposed && version == generation) await Load();
        }
    }
    private async Task Load()
    {
        if (disposed || account is null || busy || loading) return;
        var version = ++generation; loading = true; error = null;
        var planTask = Api.PlansAsync(lifetime.Token);
        var currentTask = Api.CurrentAsync(lifetime.Token);
        var historyTask = Api.PaymentsAsync(1, lifetime.Token);
        await Task.WhenAll(planTask, currentTask, historyTask);
        if (disposed || version != generation) return;
        var p = await planTask; var s = await currentTask; var h = await historyTask;
        loading = false; plans = p.Success ? p.Value : null; overview = s.Success ? s.Value : null; history = h.Success ? h.Value : null;
        error = p.Error ?? s.Error ?? h.Error;
    }
    private async Task Select(SubscriptionPlan plan)
    {
        if (busy || loading || account is null || draft is not null || overview?.Current is not null) return;
        var version = generation; busy = true;
        var pending = new SubscriptionPurchaseDraft(plan.PlanId, plan.Name, plan.Price, Guid.NewGuid(), plan.UpdatedAtUtc, false);
        try { await Drafts.WriteAsync(account, pending); if (!disposed && version == generation) { draft = pending; error = notice = null; } }
        catch (JSException) { if (!disposed && version == generation) error = "Could not save the purchase request. Enable browser storage and try again."; }
        finally { if (!disposed && version == generation) busy = false; }
    }
    private async Task Cancel()
    {
        if (account is null || draft?.Submitted != false || busy) return;
        var version = generation; busy = true;
        try { await Drafts.ClearAsync(account); if (!disposed && version == generation) draft = null; }
        catch (JSException) { if (!disposed && version == generation) error = "Could not clear the purchase request. Please reload."; }
        finally { if (!disposed && version == generation) busy = false; }
    }
    private async Task Purchase()
    {
        if (account is null || draft is null || busy || loading || disposed) return;
        var version = generation; var owner = account; var pending = draft with { Submitted = true };
        busy = true; error = notice = null;
        try
        {
            await Drafts.WriteAsync(owner, pending);
            if (disposed || version != generation) return;
            draft = pending;
            var result = await Api.PurchaseAsync(pending, lifetime.Token);
            if (disposed || version != generation) return;
            busy = false;
            if (result.Success)
            {
                notice = result.Value!.Replayed ? "Your previous simulated payment was confirmed. No duplicate charge or subscription was created." : "Simulated payment succeeded. Your plan is active for 30 days.";
                try
                {
                    await Drafts.ClearAsync(owner);
                    if (disposed || version != generation) return;
                    draft = null;
                }
                catch (JSException) { if (!disposed && version == generation) error = "Payment succeeded, but recovery storage could not be cleared. Retrying remains safe."; }
                if (disposed || version != generation) return;
                await Load();
            }
            else
            {
                error = result.Error;
                if (result.Status is 400 or 403 || result.Code is "Subscriptions.PlanChanged" or "Subscriptions.PlanUnavailable" or "Subscriptions.SubscriptionAlreadyActive" or "Subscriptions.IdempotencyConflict")
                {
                    await Drafts.ClearAsync(owner);
                    if (disposed || version != generation) return;
                    draft = null;
                    var explanation = error; var refreshVersion = generation + 1; await Load();
                    if (!disposed && generation == refreshVersion && account == owner) error = explanation;
                }
                // Unknown outcomes retain the same key across reload/navigation within this tab.
            }
        }
        catch (JSException) { if (!disposed && version == generation) error = "Could not update purchase recovery storage. Reload and retry the same purchase."; }
        finally { if (!disposed && version == generation) busy = false; }
    }
    private async Task HistoryPage(int page)
    {
        if (busy || loading || account is null) return;
        var version = generation; loading = true;
        var result = await Api.PaymentsAsync(page, lifetime.Token);
        if (disposed || version != generation) return;
        loading = false; if (result.Success) history = result.Value; else error = result.Error;
    }
    public void Dispose() { disposed = true; generation++; Session.Changed -= Changed; lifetime.Cancel(); lifetime.Dispose(); }
}
