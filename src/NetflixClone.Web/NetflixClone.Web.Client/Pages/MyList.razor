@page "/my-list"
@rendermode @(new InteractiveWebAssemblyRenderMode(prerender: false))
@implements IDisposable
@inject AuthSession Session
@inject ActiveProfileState Active
@inject MyListApiClient Api
<PageTitle>My List · Netflix Clone</PageTitle>
<AuthShell>
    <p class="eyebrow">SAVED FOR LATER</p>
    <h1 class="display-5 fw-bold">My List</h1>
    @if (!Session.IsAuthenticated) { <p>Sign in to see your saved movies.</p><a class="btn btn-danger" href="/login">Sign in</a> }
    else if (Active.Selected is null)
    {
        <p>Choose a profile to see its saved movies.</p><a class="btn btn-danger" href="/select-profile?returnTo=/my-list">Choose profile</a>
    }
    else
    {
        <div class="d-flex flex-wrap align-items-center gap-3 mb-4">
            <p class="text-muted mb-0">Saved for <strong>@Active.Selected.Name</strong></p>
            <a class="btn btn-outline-light" href="/select-profile?returnTo=/my-list">Switch profile</a>
            <button class="btn btn-outline-light" disabled="@(loading || busy)" @onclick="Load">Reload list</button>
        </div>
        @if (error is not null) { <div class="alert alert-warning" role="alert">@error</div> }
        @if (notice is not null) { <p role="status">@notice</p> }
        @if (loading) { <p role="status">Loading your movies…</p> }
        else if (movies is not null)
        {
            @if (movies.TotalCount == 0) { <div class="auth-panel p-4"><h2 class="h4">Your list is ready for its first movie.</h2><p>Open a movie and select “+ My List”.</p><a class="btn btn-danger" href="/browse">Explore movies</a></div> }
            <div class="row row-cols-2 row-cols-md-3 row-cols-lg-5 g-3 g-md-4">
                @foreach (var movie in movies.Items)
                {
                    <div class="col" @key="movie.MovieId"><article class="movie-card h-100">
                        <a class="d-block text-decoration-none text-reset" href="@($"/movies/{movie.MovieId}")">
                            <CatalogImage Src="@movie.ThumbnailUrl" Alt="@($"{movie.Title} poster")" CssClass="movie-poster" />
                            <div class="p-3"><h2 class="h6">@movie.Title</h2><p class="small text-muted mb-0">@movie.ReleaseDate?.Year · @movie.MaturityRating</p>
                            @if (!movie.IsAvailable) { <p class="small text-muted mb-0">Currently unavailable</p> }</div>
                        </a>
                        <div class="px-3 pb-3"><button class="btn btn-outline-light w-100" disabled="@(busy || needsReload)" aria-label="@($"Remove {movie.Title} from My List")" @onclick="() => Remove(movie.MovieId)">Remove</button></div>
                    </article></div>
                }
            </div>
            <nav class="d-flex justify-content-center align-items-center gap-3 mt-4" aria-label="My List pages">
                <button class="btn btn-outline-light" disabled="@(page <= 1 || busy || needsReload)" @onclick="Previous">Previous</button>
                <span>Page @(page) of @Math.Max(1, (int)Math.Ceiling(movies.TotalCount / 20d))</span>
                <button class="btn btn-outline-light" disabled="@((long)page * 20 >= movies.TotalCount || busy || needsReload)" @onclick="Next">Next</button>
            </nav>
        }
    }
</AuthShell>
@code {
    private MoviesReply? movies;
    private int page = 1;
    private long generation;
    private bool loading, busy, needsReload, disposed;
    private string? error, notice;
    private readonly CancellationTokenSource lifetime = new();
    protected override async Task OnInitializedAsync()
    {
        Active.Changed += Changed;
        await Active.InitializeAsync();
        await Load();
    }
    private void Changed() => _ = InvokeAsync(async () => { if (!disposed) { page = 1; await Load(); StateHasChanged(); } });
    private bool Current(long request, long version) => !disposed && request == generation && version == Active.Version;
    private async Task Load()
    {
        var request = ++generation; var version = Active.Version; var profileId = Active.Selected?.ProfileId;
        movies = null; loading = busy = needsReload = false; error = notice = null;
        if (profileId is null || !Session.IsAuthenticated) return;
        loading = true;
        var result = await Api.ListAsync(profileId.Value, page, lifetime.Token);
        if (!Current(request, version)) return;
        loading = false;
        if (!result.Success)
        {
            error = result.Error;
            if (result.Code == "MyList.ProfileNotFound") Active.InvalidateIfCurrent(profileId.Value, version);
            return;
        }
        movies = result.Value;
        if (page > 1 && movies!.Items.Length == 0) { page = Math.Max(1, (int)Math.Ceiling(movies.TotalCount / 20d)); await Load(); }
    }
    private async Task Remove(int movieId)
    {
        if (busy || needsReload || Active.Selected is not { } profile) return;
        var request = ++generation; var version = Active.Version; busy = true; error = notice = null;
        var result = await Api.SetAsync(profile.ProfileId, movieId, false, lifetime.Token);
        if (!Current(request, version)) return;
        busy = false;
        if (!result.Success)
        {
            error = result.Error; needsReload = true;
            if (result.Code == "MyList.ProfileNotFound") Active.InvalidateIfCurrent(profile.ProfileId, version);
            return;
        }
        await Load();
        if (!disposed && version == Active.Version && error is null) notice = "Removed from My List.";
    }
    private async Task Previous() { page--; await Load(); }
    private async Task Next() { page++; await Load(); }
    public void Dispose() { disposed = true; generation++; Active.Changed -= Changed; lifetime.Cancel(); lifetime.Dispose(); }
}
