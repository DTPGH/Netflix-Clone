@implements IDisposable
@inject AuthSession Session
@inject ActiveProfileState Active
@inject MyListApiClient Api
@if (!Session.IsAuthenticated)
{
    <a class="btn btn-outline-light" href="/login">Sign in to save movies</a>
}
else if (Active.Selected is null)
{
    <a class="btn btn-outline-light" href="@($"/select-profile?returnTo={Uri.EscapeDataString($"/movies/{MovieId}")}")">Choose a profile to save</a>
}
else
{
    <div>
        @if (error is not null) { <p class="text-warning mb-2" role="alert">@error</p> }
        @if (!known && !loading && !busy)
        {
            <button class="btn btn-outline-light" @onclick="Load">Reload My List status</button>
        }
        else
        {
            <button class="btn btn-outline-light" disabled="@(loading || busy || !known)" @onclick="Save">
                @(loading ? "Checking My List…" : busy ? "Saving…" : included ? "Remove from My List" : "+ My List")
            </button>
        }
        <span class="small text-muted d-block mt-1">For @Active.Selected.Name</span>
        @if (notice is not null) { <span class="small d-block mt-1" role="status">@notice</span> }
    </div>
}
@code {
    [Parameter] public int MovieId { get; set; }
    private bool known, included, loading, busy, disposed;
    private string? error, notice;
    private long generation;
    private readonly CancellationTokenSource lifetime = new();
    protected override async Task OnInitializedAsync()
    {
        Active.Changed += Changed;
        await Active.InitializeAsync();
    }
    protected override Task OnParametersSetAsync() => Load();
    private void Changed() => _ = InvokeAsync(async () => { if (!disposed) { await Load(); StateHasChanged(); } });
    private bool Current(long request, long profileVersion) => !disposed && request == generation && profileVersion == Active.Version;
    private async Task Load()
    {
        var request = ++generation; var version = Active.Version; var profileId = Active.Selected?.ProfileId;
        known = loading = busy = false; error = notice = null;
        if (profileId is null || !Session.IsAuthenticated) return;
        loading = true;
        var result = await Api.StatusAsync(profileId.Value, MovieId, lifetime.Token);
        if (!Current(request, version)) return;
        loading = false;
        if (!result.Success)
        {
            error = result.Error;
            if (result.Code == "MyList.ProfileNotFound") Active.InvalidateIfCurrent(profileId.Value, version);
            return;
        }
        included = result.Value!.IsInMyList; known = true;
    }
    private async Task Save()
    {
        if (busy || !known || Active.Selected is not { } profile) return;
        var request = ++generation; var version = Active.Version;
        var desired = !included; busy = true; error = notice = null;
        var result = await Api.SetAsync(profile.ProfileId, MovieId, desired, lifetime.Token);
        if (!Current(request, version)) return;
        busy = false;
        if (!result.Success)
        {
            known = false; error = result.Error;
            if (result.Code == "MyList.ProfileNotFound") Active.InvalidateIfCurrent(profile.ProfileId, version);
            return; // Unknown outcomes require a GET before another mutation.
        }
        included = desired; notice = desired ? "Added to My List." : "Removed from My List.";
    }
    public void Dispose() { disposed = true; generation++; Active.Changed -= Changed; lifetime.Cancel(); lifetime.Dispose(); }
}
