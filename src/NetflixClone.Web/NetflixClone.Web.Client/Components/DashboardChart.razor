<section class="auth-panel p-3 p-md-4 h-100">
    <h2 class="h4">@Title</h2>
    <p class="small text-muted">Daily totals · @Unit · UTC+7</p>
    <svg viewBox="0 0 640 210" class="w-100" role="img" aria-label="@($"{Title}: daily totals from {Dates.FirstOrDefault()} to {Dates.LastOrDefault()}. Exact values in the table below.")">
        <line x1="30" y1="175" x2="620" y2="175" stroke="currentColor" opacity="0.4" />
        <line x1="30" y1="25" x2="620" y2="25" stroke="currentColor" opacity="0.2" />
        <polyline points="@Points" fill="none" stroke="var(--app-accent, #e50914)" stroke-width="3" />
        @if (Values.Count == 1) { <circle cx="325" cy="@Y(Values[0])" r="4" fill="var(--app-accent, #e50914)" /> }
        <text x="30" y="18" fill="currentColor" font-size="13">@Max.ToString("N0")</text>
        <text x="30" y="198" fill="currentColor" font-size="13">@Dates.FirstOrDefault().ToString("dd/MM")</text>
        <text x="570" y="198" fill="currentColor" font-size="13">@Dates.LastOrDefault().ToString("dd/MM")</text>
    </svg>
    <details><summary class="py-2">View daily values</summary><div class="table-responsive" style="max-height: 320px">
        <table class="table table-dark table-sm"><thead><tr><th>Date</th><th class="text-end">@Unit</th></tr></thead><tbody>
            @for (var i = 0; i < Dates.Count; i++) { <tr><td>@Dates[i].ToString("dd/MM/yyyy")</td><td class="text-end">@Values[i].ToString("N0")</td></tr> }
        </tbody></table>
    </div></details>
</section>
@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter, EditorRequired] public string Unit { get; set; } = "";
    [Parameter, EditorRequired] public IReadOnlyList<DateOnly> Dates { get; set; } = [];
    [Parameter, EditorRequired] public IReadOnlyList<decimal> Values { get; set; } = [];
    private decimal Max => Values.Count == 0 ? 0 : Values.Max();
    private string Y(decimal value) => (175m - (Max == 0 ? 0 : value / Max * 150)).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    private string Points => string.Join(" ", Values.Select((v, i) => $"{(Values.Count == 1 ? 325m : 30m + i * 590m / (Values.Count - 1)).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)},{Y(v)}"));
}
